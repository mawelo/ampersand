# Build output
build/
.cache/
compile_commands.json

# Generated protobuf bindings (produced by protoc at build time)
*.pb.cc
*.pb.h

# Python / editor artefacts
__pycache__/
*.user

# AppImage build helpers fetched on demand, and the large portable build.
# The release zip is a GitHub release asset, never committed.
tools/appimage-tools/
dist/*.AppImage
releases/

# Local, non-versioned pre-push denylist (concrete private patterns)
tools/hooks/denylist.local

# Local tool and session directories (any hidden directory) — never commit.
# .github/ is the one exception: it holds repository metadata (FUNDING, etc.).
.*/
!.github/
