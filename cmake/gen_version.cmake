# gen_version.cmake — erzeugt qc_version.cpp mit Commit-ID (Build-Zeit)
#
# Wer:      Martin.Lonkwitz
# Was:      Schreibt die Versionsfunktion qc::version() als Quelldatei. Laeuft
#           bei jedem Build (Custom-Target); die Datei wird nur ersetzt, wenn
#           sich ihr Inhalt aendert, damit nicht unnoetig neu gelinkt wird.
# Wann:     2026-09-04
# Warum:    Regel: jede Versionsausgabe muss die Commit-ID tragen, auf der das
#           Artefakt basiert (eine Zeile, max. 80 Zeichen).
# Projekt:  Ampersand
# Nutzung:  cmake -DQC_OUT=<file> -DQC_SRC_DIR=<dir> -DQC_PROJECT_VERSION=<v> -P gen_version.cmake

find_package(Git QUIET)
set(commit "nogit")
set(dirty "")
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} -C "${QC_SRC_DIR}" rev-parse --short=10 HEAD
        OUTPUT_VARIABLE commit_out OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE rc ERROR_QUIET)
    if(rc EQUAL 0 AND NOT commit_out STREQUAL "")
        set(commit "${commit_out}")
        execute_process(
            COMMAND ${GIT_EXECUTABLE} -C "${QC_SRC_DIR}" status --porcelain --untracked-files=no
            OUTPUT_VARIABLE status_out OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT status_out STREQUAL "")
            set(dirty "-dirty")
        endif()
    endif()
endif()

string(TIMESTAMP build_date "%Y-%m-%d" UTC)
# One line, <= 80 characters, e.g.
#   ampersand 0.1.0+a1b2c3d4e5 (2026-09-04)
set(version_line "ampersand ${QC_PROJECT_VERSION}+${commit}${dirty} (${build_date})")

set(content "// Generated by cmake/gen_version.cmake - do not edit.
#include \"qc/version.hpp\"

namespace qc {
std::string_view version() noexcept { return \"${version_line}\"; }
std::string_view commit_id() noexcept { return \"${commit}${dirty}\"; }
}  // namespace qc
")

set(old "")
if(EXISTS "${QC_OUT}")
    file(READ "${QC_OUT}" old)
endif()
if(NOT old STREQUAL content)
    get_filename_component(dir "${QC_OUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    file(WRITE "${QC_OUT}" "${content}")
endif()
